# Copy to .env and configure before running locally.
MOVIE_DATA_DIR=data/processed
MOVIE_DB_PATH=data/movie_app.db
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=90

# Optional demo admin. Keep this disabled unless you explicitly need an admin.
ENABLE_ADMIN_DEMO=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set true when serving over HTTPS.
COOKIE_SECURE=false
